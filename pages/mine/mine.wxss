.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 28rpx 28rpx 60rpx;
}

.profile-card {
    display: flex;
    align-items: center;
    padding: 34rpx 30rpx;
    border-radius: 32rpx;
    background: linear-gradient(135deg, #6b4a34, #44301f);
    box-shadow: 0 14rpx 32rpx rgba(58, 43, 33, 0.22);
}

.avatar {
    width: 104rpx;
    height: 104rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    color: #f3e3ce;
    font-size: 44rpx;
    font-weight: 700;
    line-height: 104rpx;
    text-align: center;
    flex-shrink: 0;
}

.profile-main {
    flex: 1;
    margin-left: 24rpx;
}

.nickname {
    font-size: 36rpx;
    font-weight: 700;
    color: #ffffff;
}

.member-row {
    display: flex;
    align-items: center;
    margin-top: 12rpx;
}

.member-badge {
    font-size: 20rpx;
    color: #6b4a34;
    background: #e8c89b;
    border-radius: 8rpx;
    padding: 4rpx 12rpx;
}

.member-days {
    font-size: 21rpx;
    color: rgba(255, 255, 255, 0.62);
    margin-left: 14rpx;
}

.points {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.points-value {
    font-size: 38rpx;
    font-weight: 700;
    color: #e8c89b;
}

.points-label {
    font-size: 20rpx;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 4rpx;
}

.stat-row {
    display: flex;
    align-items: center;
    margin-top: 24rpx;
    background: #ffffff;
    border-radius: 26rpx;
    padding: 28rpx 0;
    box-shadow: 0 8rpx 24rpx rgba(107, 74, 52, 0.05);
}

.stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-value {
    font-size: 38rpx;
    font-weight: 700;
    color: #2b2119;
}

.stat-label {
    font-size: 22rpx;
    color: #a2958a;
    margin-top: 8rpx;
}

.stat-divider {
    width: 1rpx;
    height: 48rpx;
    background: #f0e6da;
}

.menu-card {
    margin-top: 24rpx;
    background: #ffffff;
    border-radius: 26rpx;
    padding: 4rpx 26rpx;
    box-shadow: 0 8rpx 24rpx rgba(107, 74, 52, 0.05);
}

.menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f6efe6;
}

.menu-item:last-child {
    border-bottom: none;
}

.menu-name {
    font-size: 28rpx;
    color: #40342b;
}

.menu-danger {
    color: #b4462f;
}

.menu-extra {
    font-size: 23rpx;
    color: #a2958a;
    margin-right: 8rpx;
}

.menu-arrow {
    font-size: 32rpx;
    color: #cdc1b5;
}

.footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 60rpx;
}

.footer-text {
    font-size: 23rpx;
    color: #b0a49a;
    letter-spacing: 2rpx;
}

.footer-sub {
    font-size: 20rpx;
    color: #c9bdb2;
    margin-top: 12rpx;
}
