.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 28rpx 220rpx;
}

/* ---------- 门店卡 ---------- */
.store-card {
    background: linear-gradient(140deg, #ffffff 0%, #fdf8f2 100%);
    border-radius: 32rpx;
    padding: 28rpx;
    box-shadow: 0 10rpx 30rpx rgba(107, 74, 52, 0.07);
}

.store-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.store-left {
    flex: 1;
    min-width: 0;
}

.store-name {
    font-size: 36rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.store-meta {
    display: flex;
    align-items: center;
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #8c8078;
}

.status-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #6fae72;
    margin-right: 8rpx;
}

.meta-divider {
    margin: 0 12rpx;
    color: #d8cdc2;
}

.store-call {
    padding: 10rpx 24rpx;
    border-radius: 26rpx;
    border: 2rpx solid #e6d9cb;
    font-size: 22rpx;
    color: #6b4a34;
    margin-left: 16rpx;
}

.method-row {
    display: flex;
    margin-top: 26rpx;
    background: #f4ece3;
    border-radius: 22rpx;
    padding: 8rpx;
}

.method-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14rpx 0;
    border-radius: 16rpx;
    color: #8c8078;
}

.method-tab.is-active {
    background: #ffffff;
    color: #6b4a34;
    box-shadow: 0 4rpx 12rpx rgba(107, 74, 52, 0.08);
}

.method-title {
    font-size: 27rpx;
    font-weight: 600;
}

.method-sub {
    font-size: 21rpx;
    margin-top: 6rpx;
    opacity: 0.75;
}

/* ---------- 活动条 ---------- */
.notice-bar {
    display: flex;
    align-items: center;
    margin-top: 24rpx;
    padding: 20rpx 24rpx;
    background: #fdf1e3;
    border-radius: 20rpx;
}

.notice-tag {
    font-size: 20rpx;
    color: #ffffff;
    background: #c8813f;
    border-radius: 8rpx;
    padding: 4rpx 10rpx;
    margin-right: 14rpx;
}

.notice-text {
    flex: 1;
    font-size: 24rpx;
    color: #8a5a2b;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.notice-arrow {
    font-size: 28rpx;
    color: #c8813f;
    margin-left: 12rpx;
}

/* ---------- 分类 ---------- */
.cat-scroll {
    margin: 26rpx 0 8rpx;
    white-space: nowrap;
}

.cat-list {
    display: inline-flex;
    align-items: center;
    padding: 4rpx 0;
}

.cat-item {
    display: inline-block;
    padding: 14rpx 30rpx;
    margin-right: 16rpx;
    border-radius: 30rpx;
    background: #ffffff;
    font-size: 25rpx;
    color: #7d6f64;
    border: 2rpx solid #f0e6da;
}

.cat-item.is-active {
    background: #6b4a34;
    border-color: #6b4a34;
    color: #ffffff;
    font-weight: 600;
}

/* ---------- 商品列表 ---------- */
.product-list {
    margin-top: 16rpx;
}

.product-card {
    display: flex;
    padding: 24rpx;
    margin-bottom: 20rpx;
    background: #ffffff;
    border-radius: 26rpx;
    box-shadow: 0 8rpx 24rpx rgba(107, 74, 52, 0.05);
}

.thumb {
    width: 168rpx;
    height: 168rpx;
    border-radius: 22rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
}

.thumb::after {
    content: "";
    position: absolute;
    top: -40rpx;
    right: -50rpx;
    width: 130rpx;
    height: 130rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
}

.thumb-text {
    font-size: 52rpx;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.94);
    letter-spacing: 2rpx;
}

.product-info {
    flex: 1;
    min-width: 0;
    margin-left: 24rpx;
    display: flex;
    flex-direction: column;
}

.product-head {
    display: flex;
    align-items: center;
}

.product-name {
    font-size: 30rpx;
    font-weight: 600;
    max-width: 320rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.product-tag {
    font-size: 19rpx;
    color: #b4703a;
    background: #fbeee0;
    border-radius: 8rpx;
    padding: 4rpx 10rpx;
    margin-left: 12rpx;
    flex-shrink: 0;
}

.product-sub {
    font-size: 21rpx;
    color: #b0a49a;
    margin-top: 6rpx;
    letter-spacing: 1rpx;
}

.product-desc {
    font-size: 22rpx;
    color: #8c8078;
    line-height: 32rpx;
    margin-top: 10rpx;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.product-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 12rpx;
}

.price-wrap {
    display: flex;
    align-items: baseline;
}

.price-symbol {
    font-size: 22rpx;
    color: #b4462f;
    margin-right: 2rpx;
}

.price-value {
    font-size: 34rpx;
    font-weight: 700;
    color: #b4462f;
}

.price-from {
    font-size: 20rpx;
    color: #b0a49a;
    margin-left: 6rpx;
}

.add-btn {
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
    background: #6b4a34;
    color: #ffffff;
    font-size: 34rpx;
    line-height: 52rpx;
    text-align: center;
    box-shadow: 0 6rpx 14rpx rgba(107, 74, 52, 0.28);
}

.retry {
    margin-top: 28rpx;
    width: 240rpx;
}

/* ---------- 购物车悬浮条 ---------- */
.cart-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 24rpx 24rpx;
    box-sizing: border-box;
    z-index: 20;
}

.cart-inner {
    display: flex;
    align-items: center;
    height: 108rpx;
    padding: 0 12rpx 0 24rpx;
    border-radius: 54rpx;
    background: #3a2b21;
    box-shadow: 0 14rpx 32rpx rgba(58, 43, 33, 0.3);
}

.cart-badge {
    min-width: 44rpx;
    height: 44rpx;
    padding: 0 8rpx;
    border-radius: 22rpx;
    background: #d79a52;
    color: #3a2b21;
    font-size: 24rpx;
    font-weight: 700;
    line-height: 44rpx;
    text-align: center;
}

.cart-summary {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin-left: 20rpx;
}

.cart-total {
    font-size: 34rpx;
    font-weight: 700;
    color: #ffffff;
}

.cart-tip {
    font-size: 21rpx;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 4rpx;
}

.cart-action {
    height: 84rpx;
    line-height: 84rpx;
    padding: 0 46rpx;
    border-radius: 42rpx;
    background: linear-gradient(135deg, #d79a52, #c07d35);
    color: #ffffff;
    font-size: 29rpx;
    font-weight: 600;
}
